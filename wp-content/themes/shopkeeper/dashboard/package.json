{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "Get Bowtied Dashboard",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "icons:sync": "node ./scripts/sync-icons.mjs",
    "postinstall": "npm run icons:sync",
    "dev": "npm run icons:sync && npx @tailwindcss/cli -i ./css/tailwind.css -o ./css/dashboard.css --watch",
    "build": "npm run icons:sync && npx @tailwindcss/cli -i ./css/tailwind.css -o ./css/dashboard.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "postcss": "^8.5.6"
  },
  "dependencies": {
    "heroicons": "^2.2.0",
    "tailwindcss": "^4.1.14"
  }
}
